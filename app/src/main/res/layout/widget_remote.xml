<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn by the launcher, which has no app theme behind it, so the background is not overdraw. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="6dp"
    tools:ignore="Overdraw">

    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_key"
        android:contentDescription="@string/tile_play_pause"
        android:src="@drawable/ic_play_pause"
        android:tint="@color/amber" />

    <ImageButton
        android:id="@+id/widget_mute"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_key"
        android:contentDescription="@string/tile_mute"
        android:src="@drawable/ic_mute"
        android:tint="@color/bone" />

    <ImageButton
        android:id="@+id/widget_lock"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_key"
        android:contentDescription="@string/tile_lock"
        android:src="@drawable/ic_lock"
        android:tint="@color/bone" />
</LinearLayout>
