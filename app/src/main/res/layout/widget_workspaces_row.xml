<?xml version="1.0" encoding="utf-8"?>
<!-- The one-cell-high form: no header, so every key gets the full height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="8dp"
    tools:ignore="Overdraw,HardcodedText">

        <TextView
            android:id="@+id/widget_ws_1"
            style="@style/WidgetKey"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_2"
            style="@style/WidgetKey.Tight"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_3"
            style="@style/WidgetKey.Tight"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="3"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_4"
            style="@style/WidgetKey.Tight"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="4"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_5"
            style="@style/WidgetKey.Tight"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="5"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_6"
            style="@style/WidgetKey.Tight"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="6"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_7"
            style="@style/WidgetKey.Tight"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="7"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_8"
            style="@style/WidgetKey.Tight"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_9"
            style="@style/WidgetKey.Tight"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="9"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_10"
            style="@style/WidgetKey.Tight"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="10"
            android:textSize="15sp" />
</LinearLayout>
