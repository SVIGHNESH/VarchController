<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn by the launcher, which has no app theme behind it, so the background is not overdraw. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp"
    tools:ignore="Overdraw,HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_host"
            style="@style/WidgetLabel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/widget_host" />

        <TextView
            android:id="@+id/widget_sync"
            style="@style/WidgetLabel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="0dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        tools:ignore="NestedWeights">

        <TextView
            android:id="@+id/widget_ws_1"
            style="@style/WidgetKey"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_2"
            style="@style/WidgetKey.Next"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_3"
            style="@style/WidgetKey.Next"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="3"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_4"
            style="@style/WidgetKey.Next"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="4"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_5"
            style="@style/WidgetKey.Next"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="5"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        tools:ignore="NestedWeights">

        <TextView
            android:id="@+id/widget_ws_6"
            style="@style/WidgetKey"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="6"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_7"
            style="@style/WidgetKey.Next"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="7"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_8"
            style="@style/WidgetKey.Next"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_9"
            style="@style/WidgetKey.Next"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="9"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ws_10"
            style="@style/WidgetKey.Next"
            android:drawableBottom="@drawable/widget_dot_none"
            android:paddingTop="9dp"
            android:paddingBottom="4dp"
            android:text="10"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
