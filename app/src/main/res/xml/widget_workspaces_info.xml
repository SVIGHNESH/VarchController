<?xml version="1.0" encoding="utf-8"?>
<!-- previewLayout and targetCell* are read by Android 12+ and ignored below it. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_workspaces_description"
    android:initialLayout="@layout/widget_workspaces_row"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:previewLayout="@layout/widget_workspaces_row"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
